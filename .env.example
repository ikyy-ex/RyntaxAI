# Server Configuration
PORT=3000
NODE_ENV=development

# Google Gemini API Key (Wajib - Dapatkan dari https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Keamanan Sesi JWT (Ganti dengan string acak panjang di produksi)
JWT_SECRET=ganti_dengan_secret_acak_minimal_32_karakter_ryntax_ai

# Opsional: Supabase PostgreSQL (Jika kosong, otomatis menggunakan penyimpanan lokal aman)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opsional: Origin yang diizinkan untuk CORS (pisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost:3000
